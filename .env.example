# Site
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk (비우면 로그인 없이 공개 사이트)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RELEASES_BUCKET=releases

# Storage object paths (public bucket) — 또는 아래 직접 URL
STORAGE_PATH_WIN_PORTABLE=MethodosBasic-LT-4-all-v4-R19-Ngraph-AuthV1.exe
# Direct download URLs (override defaults; see lib/download-url.ts)
NEXT_PUBLIC_DOWNLOAD_WIN_PORTABLE_URL=
NEXT_PUBLIC_DOWNLOAD_WIN_SETUP_URL=
NEXT_PUBLIC_DOWNLOAD_MAC_X64_DMG_URL=
NEXT_PUBLIC_DOWNLOAD_MAC_ARM64_DMG_URL=

# 로컬 개발: LT 폴더에서 exe 직접 스트리밍 (production 비활성)
LOCAL_RELEASES_DIR=C:/Users/saran/OneDrive/Desktop/통계 개발/methodos-basic-v2/MethodosBasic-LT-7-6개월

# ── 인증키(라이선스) 서버 — 데스크톱 앱이 이 사이트의 /api/activate 등을 부른다 ──
# Supabase SQL editor 에서 supabase/license_keys.sql 을 한 번 실행하고,
# 위의 NEXT_PUBLIC_SUPABASE_URL · SUPABASE_SERVICE_ROLE_KEY 를 채운다 (서비스 롤 키는 비밀).
# 서명 개인키(PEM). 줄바꿈은 
 으로 적어도 된다. license-server/data/keys/private.pem 의 내용.
LICENSE_PRIVATE_KEY=
# 발급 도구(tools/admin.cjs)가 쓰는 관리자 토큰 — 길고 무작위로.
LICENSE_ADMIN_TOKEN=
# 선택: 온라인 임대 기간(일, 기본 7) · "오늘"을 세는 시간대(UTC+N, 기본 9=한국)
LICENSE_LEASE_DAYS=7
LICENSE_TZ_OFFSET_HOURS=9

# ── 관리 웹페이지(/admin) — Clerk 로그인 + 허용 목록 ──
# 목록이 모두 비어 있으면 아무도 /admin 에 들어올 수 없다. 이메일·번호는 Clerk 에서 인증이 끝난 것만 인정한다.
ADMIN_EMAILS=
# 휴대폰: 010-1234-5678 도 +82 10 1234 5678 도 같은 번호로 본다. 쉼표로 여러 개.
ADMIN_PHONES=
# (선택) Clerk 사용자 ID(user_...)로 직접 지정
ADMIN_CLERK_USER_IDS=
